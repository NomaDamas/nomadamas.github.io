---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

// 발행일은 늘 보이고, 수정일은 발행 뒤에 고쳤을 때만 옆에 붙인다
const tz = postTimezone ?? config.site.timezone;
const published = dayjs(pubDatetime).tz(tz);
const updated = isModified ? dayjs(modDatetime).tz(tz) : null;
const format = (d: dayjs.Dayjs) => d.format("D MMM, YYYY");
const textClass = ["text-sm", { "sm:text-base": size === "lg" }];
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <span class:list={textClass}>{t.post.publishedAt}:</span>
  <time class:list={textClass} datetime={published.toISOString()}>
    {format(published)}
  </time>
  {
    updated && (
      <>
        <span class:list={textClass} aria-hidden="true">
          /
        </span>
        <span class:list={textClass}>{t.post.updatedAt}:</span>
        <time class:list={textClass} datetime={updated.toISOString()}>
          {format(updated)}
        </time>
      </>
    )
  }
</div>
