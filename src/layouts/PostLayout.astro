---
import Layout from "./Layout.astro";
import config from "@/config";
import {
  author as authorNode,
  organization,
  person,
} from "@/utils/structuredData";
import type { PostAuthor } from "@/utils/postAuthors";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  /** 사이트명 접미사가 붙기 전의 글 제목. title은 <title>용이라 " | NomaDamas"가 붙어 있다. */
  headline?: string;
  /** 프런트매터 author. byline이 없을 때만 쓴다. */
  author?: string;
  /** 제목 아래 보이는 작성자(GitHub 계정). 메타 태그와 구조화 데이터의 글쓴이가 된다. */
  byline?: PostAuthor | null;
  tags?: string[];
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  headline,
  author = site.author,
  byline,
  tags = [],
} = Astro.props;

const pageUrl = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
// 구글은 dateModified를 권장한다. 수정한 적이 없으면 발행일이 곧 마지막 수정일이다.
const lastModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  ...(ogImage && { image: ogImage }),
  url: pageUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: site.lang,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  ...(tags.length > 0 && { keywords: tags }),
  author: byline ? person(byline.name, byline.url) : authorNode(author),
  publisher: organization(),
};
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  ogType="article"
  author={byline?.name ?? author}
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
