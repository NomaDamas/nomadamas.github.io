---
// 방문 분석 안내. GA4와 Clarity 약관이 사이트에 사용 사실을 알리도록 요구한다.
// 켜진 도구만 적도록 SiteAnalytics.astro와 같은 저장소 변수를 읽는다. 변수를 바꾸면 이 페이지도 따라 바뀐다.
import {
  PUBLIC_CLARITY_PROJECT_ID,
  PUBLIC_GA_MEASUREMENT_ID,
} from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const title = "방문 분석 안내";
const usesGa = Boolean(PUBLIC_GA_MEASUREMENT_ID);
const usesClarity = Boolean(PUBLIC_CLARITY_PROJECT_ID);
---

<Layout
  title={`${title} | ${config.site.title}`}
  description="이 블로그가 사용하는 방문 분석 도구를 안내합니다."
>
  <Header />

  <Main pageTitle={title} class="app-prose">
    {
      usesGa || usesClarity ? (
        <>
          <p>이 블로그는 쿠키로 방문 정보를 수집하는 아래 도구를 사용합니다.</p>
          <ul>
            {usesGa && (
              <li>
                Google Analytics 4 (
                <a href="https://policies.google.com/technologies/partner-sites?hl=ko">
                  Google 데이터 사용 안내
                </a>
                )
              </li>
            )}
            {usesClarity && (
              <li>
                Microsoft Clarity (
                <a href="https://privacy.microsoft.com/privacystatement">
                  Microsoft 개인정보처리방침
                </a>
                )
              </li>
            )}
          </ul>
        </>
      ) : (
        <p>현재 사용하는 방문 분석 도구가 없습니다.</p>
      )
    }
  </Main>

  <Footer />
</Layout>
