---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>없어서 만드는 집</h1>
			<p>
				NomaDamas는 서울에 있는 AI 오픈소스 해커하우스예요. 필요한데 아무도 안 만든 걸 만들고,
				만든 건 전부 <a href="https://github.com/NomaDamas">GitHub</a>에 공개해요.{' '}
				<a href="https://markr.ai">Markr</a>가 운영합니다.
			</p>
			<p>
				이 블로그에는 만드는 과정을 적어요. 왜 만들었는지, 어떻게 굴러가는지, 어디서 막혔고
				무엇으로 풀었는지. 결과만 놓고 자랑하는 글보다 과정이 남는 글을 쓰려고 해요.
			</p>

			{posts.length > 0 && (
				<section class="recent">
					<h2>최근 글</h2>
					<ul>
						{posts.map((post) => (
							<li>
								<a href={`/posts/${post.id}/`}>{post.data.title}</a>
								<FormattedDate date={post.data.pubDate} />
							</li>
						))}
					</ul>
					<p><a href="/posts/">글 전체 보기</a></p>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.recent {
		margin-top: 3rem;
	}
	.recent ul {
		list-style: none;
		padding: 0;
	}
	.recent li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent li :global(time) {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin-left: auto;
	}
</style>
