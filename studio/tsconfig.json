{
  // 스튜디오는 Node가 TypeScript를 그대로 실행한다(타입만 지우는 방식).
  // 그래서 지울 수 없는 문법(enum, namespace)을 막고 import에 .ts 확장자를 쓴다.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
